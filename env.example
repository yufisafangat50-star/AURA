# .env.example — Aura (ResearchPilot) V1 Backend
# Salin ke .env.local (Next.js) dan isi nilai aslinya. JANGAN commit file .env yang sudah terisi ke git.

# ── Supabase (Database Postgres + pgvector + Auth) ──────────────────
# Didapat dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key HANYA dipakai di server (API routes), jangan pernah expose ke client/browser
SUPABASE_SERVICE_ROLE_KEY=

# Connection string langsung ke Postgres (dipakai kalau pakai ORM seperti Prisma/Drizzle
# di luar Supabase client). Didapat dari: Project Settings → Database → Connection string
DATABASE_URL=

# ── LLM ───────────────────────────────────────────────────────────
# Google AI Studio (Gemini API) — https://aistudio.google.com/apikey, gratis dengan rate limit
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Literature Retrieval ─────────────────────────────────────────
# Semantic Scholar: pencarian dasar tidak wajib pakai API key.
# Isi ini hanya kalau sudah daftar untuk rate limit lebih tinggi:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
